{
  "$schema": "https://opencode.ai/config.json",
  "username": "dev",
  "model": "opencode-zen/mimo-v2.5-free",
  "small_model": "opencode-zen/mimo-v2.5-free",
  "default_agent": "build",
  "instructions": ["AGENTS.md"],
  "share": "disabled",
  "autoupdate": "notify",
  "snapshot": true,
  "skills": {
    "paths": [
      "F:\\CD\\Opencode\\.opencode\\skills",
      "F:\\CD\\Opencode\\.opencode\\agent-skills\\skills",
      "F:\\CD\\Opencode\\.opencode\\last30days-skill\\skills",
      "F:\\CD\\Opencode\\.opencode\\vercel-agent-skills\\skills",
      "F:\\CD\\Opencode\\.opencode\\anthropic-skills\\skills",
      "F:\\CD\\Opencode\\.agents\\skills",
      "C:\\Users\\user\\.agents\\skills",
      "C:\\Users\\user\\.config\\opencode\\skills"
    ]
  },
  "permission": {
    "edit": {
      "*": "allow",
      "F:\\CD\\Opencode\\opencode.json": "deny",
      "F:\\CD\\Opencode\\AGENTS.md": "deny",
      "F:\\CD\\Opencode\\.opencode\\memory.jsonl": "deny"
    },
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git branch *": "allow",
      "git remote *": "allow",
      "ls *": "allow",
      "dir *": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "echo *": "allow",
      "Test-Path *": "allow",
      "Get-ChildItem *": "allow",
      "Get-Item *": "allow",
      "Get-Content *": "allow",
      "Select-Object *": "allow",
      "Select-String *": "allow",
      "Where-Object *": "allow",
      "Get-Command *": "allow",
      "Get-Date *": "allow",
      "node --version": "allow",
      "npm --version": "allow",
      "python --version": "allow",
      "node -e *": "allow",
      "npx *": "allow",
      "npm install *": "allow",
      "npm run *": "allow",
      "npm test *": "allow",
      "npm exec *": "allow",
      "tsc *": "allow",
      "tsx *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git checkout *": "allow",
      "git switch *": "allow",
      "git merge *": "allow",
      "git rebase *": "allow",
      "git pull *": "allow",
      "git fetch *": "allow",
      "git stash *": "allow",
      "git worktree *": "allow",
      "git tag *": "allow",
      "git push": "ask",
      "git push *": "ask",
      "git reset --hard *": "ask",
      "git clean -fd *": "ask",
      "Remove-Item *": "ask",
      "New-Item *": "allow",
      "Copy-Item *": "ask",
      "Move-Item *": "ask",
      "Set-Content *": "ask",
      "Add-Content *": "allow",
      "Clear-Content *": "ask",
      "python *": "allow",
      "pip *": "allow",
      "pip3 *": "allow",
      "uv *": "allow",
      "uvx *": "allow",
      "cargo *": "allow",
      "rustc *": "allow",
      "go *": "allow",
      "dotnet *": "allow",
      "mvn *": "allow",
      "gradle *": "allow",
      "make *": "allow",
      "cmake *": "allow",
      "docker *": "ask",
      "docker-compose *": "ask",
      "kubectl *": "allow",
      "terraform *": "allow",
      "prettier *": "allow",
      "eslint *": "allow",
      "black *": "allow",
      "ruff *": "allow",
      "mypy *": "allow",
      "pyright *": "allow",
      "curl *": "allow",
      "wget *": "allow",
      "headroom *": "allow"
    },
    "webfetch": "allow",
    "external_directory": {
      "F:\\CD\\**": "allow",
      "*": "ask"
    }
  },
  "provider": {
    "hcnsec": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "HuanCheng",
      "options": {
        "baseURL": "https://api.hcnsec.cn/v1",
        "apiKey": "{env:HCNSEC_API_KEY}"
      },
      "models": {
        "auto": {
          "name": "Auto (smart routing)",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "glm-4.7": {
          "name": "GLM 4.7",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "glm-5.2": {
          "name": "GLM 5.2 (flagship, slow ~2-4min)",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "MiniMax-M3": {
          "name": "MiniMax M3 (recommended)",
          "limit": {
            "context": 1000000,
            "output": 16384
          }
        },
        "MiniMax-M2.7": {
          "name": "MiniMax M2.7",
          "limit": {
            "context": 200000,
            "output": 4096
          }
        },
        "DeepSeek-V4-Flash": {
          "name": "DeepSeek V4 Flash (fast)",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "DeepSeek-V4-Pro": {
          "name": "DeepSeek V4 Pro",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "Qwen3-Coder-Next-FP8": {
          "name": "Qwen3 Coder Next FP8",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "Qwen3.5-397B-A17B": {
          "name": "Qwen 3.5 397B",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "Qwen3.6-35B-A3B": {
          "name": "Qwen 3.6 35B",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "kat-coder-pro-v2": {
          "name": "Kat Coder Pro v2",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "kat-coder-pro-v2.5": {
          "name": "Kat Coder Pro v2.5",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "Spark-X2-Flash": {
          "name": "Spark X2 Flash",
          "limit": {
            "context": 128000,
            "output": 4096
          }
        },
        "sensenova-6.7-flash-lite": {
          "name": "SenseNova 6.7 Flash Lite",
          "limit": {
            "context": 128000,
            "output": 4096
          }
        },
        "step-3.5-flash": {
          "name": "Step 3.5 Flash",
          "limit": {
            "context": 128000,
            "output": 4096
          }
        },
        "step-3.5-flash-2603": {
          "name": "Step 3.5 Flash 2603",
          "limit": {
            "context": 128000,
            "output": 4096
          }
        },
        "step-3.7-flash": {
          "name": "Step 3.7 Flash",
          "limit": {
            "context": 128000,
            "output": 4096
          }
        },
        "step-router-v1": {
          "name": "Step Router v1",
          "limit": {
            "context": 128000,
            "output": 4096
          }
        },
        "stepaudio-2.5-chat": {
          "name": "StepAudio 2.5 Chat (voice)",
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "model": "ollama-cloud/minimax-m3",
      "mode": "primary"
    },
    "plan": {
      "model": "ollama-cloud/minimax-m3",
      "mode": "primary"
    },
    "architect": {
      "model": "opencode-zen/mimo-v2.5-free",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    },
    "reviewer": {
      "model": "opencode-zen/mimo-v2.5-free",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    },
    "tester": {
      "model": "opencode-zen/mimo-v2.5-free",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": {
          "Remove-Item *": "deny",
          "Set-Content *": "deny",
          "Clear-Content *": "deny",
          "Move-Item *": "deny",
          "Copy-Item *": "deny"
        }
      }
    },
    "explorer": {
      "model": "opencode-zen/mimo-v2.5-free",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "allow"
      }
    },
    "oracle": {
      "model": "opencode-zen/mimo-v2.5-free",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    },
    "librarian": {
      "model": "opencode-zen/mimo-v2.5-free",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    },
    "fixer": {
      "model": "opencode-zen/mimo-v2.5-free",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    },
    "designer": {
      "model": "opencode-zen/mimo-v2.5-free",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    },
    "observer": {
      "model": "opencode-zen/mimo-v2.5-free",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    },
    "council": {
      "model": "opencode-zen/mimo-v2.5-free",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    },
    "orchestrator": {
      "model": "opencode-zen/mimo-v2.5-free",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    },
    "addy-code-reviewer": {
      "model": "opencode-zen/mimo-v2.5-free",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    },
    "addy-security-auditor": {
      "model": "opencode-zen/mimo-v2.5-free",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    },
    "addy-test-engineer": {
      "model": "opencode-zen/mimo-v2.5-free",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    },
    "addy-web-perf-auditor": {
      "model": "opencode-zen/mimo-v2.5-free",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    }
  },
  "lsp": {
    "typescript-language-server": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx"]
    },
    "pyright": {
      "command": ["pyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    }
  },
  "formatter": {
    "prettier": {
      "command": ["prettier", "--write", "$FILE"],
      "extensions": [
        ".js",
        ".jsx",
        ".ts",
        ".tsx",
        ".json",
        ".md",
        ".css",
        ".html",
        ".yml",
        ".yaml"
      ]
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true,
      "env": {
        "BROWSER": "chromium"
      }
    },
    "memory": {
      "type": "local",
      "command": ["F:\\CD\\Opencode\\.opencode\\memory-mcp-wrapper.bat"],
      "enabled": true
    },
    "tavily": {
      "type": "local",
      "command": ["npx", "-y", "tavily-mcp@latest"],
      "enabled": true,
      "env": {
        "TAVILY_API_KEY": "{env:TAVILY_API_KEY}"
      }
    },
    "fetch": {
      "type": "local",
      "command": ["uvx", "mcp-server-fetch"],
      "enabled": true,
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "F:\\CD"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    },
    "headroom": {
      "type": "local",
      "command": ["headroom", "mcp", "serve"],
      "enabled": true
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "enabled": true
    },
    "composio": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "enabled": true
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?read_only=true",
      "enabled": true
    },
    "grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "F:\\CD\\Opencode\\.opencode\\github-mcp-server\\github-mcp-server.exe",
        "stdio",
        "--toolsets",
        "repos,issues,pull_requests,actions,code_security,discussions,orgs,users,gists"
      ],
      "enabled": true,
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com",
      "enabled": true
    },
    "vision-tool": {
      "type": "local",
      "command": [
        "python",
        "F:\\CD\\Opencode\\.opencode\\tools\\vision-tool\\vision_mcp_server.py"
      ],
      "enabled": true,
      "timeout": 60000,
      "env": { "GEMINI_API_KEY": "{env:GEMINI_API_KEY}" }
    }
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git#d884ae04edebef577e82ff7c4e143debd0bbec99",
    "opencode-notify",
    "envsitter-guard",
    "@dietrichgebert/ponytail"
  ],
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 65536
  },
  "compaction": {
    "auto": false,
    "tail_turns": 15
  }
}
