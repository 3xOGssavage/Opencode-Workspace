# Projects: local-only — 2.95GB of sub-repos. NEVER commit. Guarded by:
#   Layer A: .githooks/pre-commit (rejects staged Projects/* paths)
#   Layer C: .github/workflows/projects-guard.yml (fails PR if Projects/ diff)
#   Layer D: this .gitignore rule; Layer E: AGENTS.md "Projects/ is local-only"
/Projects/*
!/Projects/.gitignore
!/Projects/.gitkeep

# Secrets — never commit
/session-*.md

# Workspace backup artifacts (not config)
/.opencode/backups/
/.opencode/tools/vision-tool/docs/demo/
/.opencode/tools/vision-tool/__pycache__/

# Vendored skill packs (auto-reinstallable)
/.opencode/agent-skills/
/.opencode/anthropic-skills/
/.opencode/last30days-skill/
/.opencode/vercel-agent-skills/
/.opencode/playwright-bp-skill/
/.opencode/github-mcp-server/
/.opencode/node_modules/
/.agents/

# OS cruft
*.bak
*.bak.parallel
*.zip
*.db
*.db-shm
*.db-wal
.DS_Store
Thumbs.db
desktop.ini

# Runtime
*.log
*.tmp

# Local backup state (marker file written by backup-workspace.ps1)
/scripts/.last-backup

# Memory MCP knowledge graph (snapshot in git history; future writes are local-only.
# To update the snapshot: git add -f .opencode/memory.jsonl)
/.opencode/memory.jsonl

# Tavily rotator runtime state (cooldowns + dead marks, key suffixes only)
/.opencode/tavily-state.json

# Browser-use stack (ADR-008)
/.opencode/browser_use/.venv/
/.opencode/browser_use/profiles/
/.opencode/browser_use/__pycache__/
/.opencode/browser_use/agent_runner.log
/.opencode/tools/__pycache__/
/.opencode/browser_use/.setup-done

# MCP runtime cache
/.playwright-mcp/

# Diagnostic logs (botscore, validation runs — regenerated by botscore.py:126)
/logs/

# Codemap.md — regenerable via the codemap skill (ask agent:
#   "generate a codemap for this repo"). Output is gitignored as regenerable.
codemap.md

# .slim/ — local-only slim-mode state (not config)
/.slim/

# Local secrets files (defense-in-depth beyond session-*.md + auth.json)
*.secrets-local.ps1
*.secrets-local.json
secrets.local.ps1
secrets.local.json

# Skill install / reinstall artifacts (regenerable by install-user-skills.ps1)
/.opencode/skill-reinstall-artifacts/

